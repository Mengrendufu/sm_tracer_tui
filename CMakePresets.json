{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/${presetName}",
      "toolchainFile": "${sourceDir}/toolchain_gcc.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_STANDARD": "99",
        "CMAKE_C_STANDARD_REQUIRED": "ON",
        "CMAKE_C_EXTENSIONS": "OFF",
        "CMAKE_C_FLAGS_DEBUG": "-O0 -g3",
        "CMAKE_C_FLAGS_RELEASE": "-O2 -g3 -DNDEBUG"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Configure Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Configure Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "$env{LOCALAPPDATA}/sm_tracer_tui/build/${presetName}",
      "toolchainFile": "${sourceDir}/toolchain_mingw_ucrt64.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "displayName": "Configure Windows Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NOTCURSES_ROOT": "$env{LOCALAPPDATA}/notcurses-win-patched/install-ucrt64"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "displayName": "Configure Windows Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NOTCURSES_ROOT": "$env{LOCALAPPDATA}/notcurses-win-patched/install-ucrt64"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "build-debug",
      "displayName": "Build Debug",
      "description": "Build the Debug preset.",
      "configurePreset": "debug"
    },
    {
      "name": "build-release",
      "displayName": "Build Release",
      "description": "Build the Release preset.",
      "configurePreset": "release"
    },
    {
      "name": "clean-debug",
      "displayName": "Clean Debug",
      "description": "Clean the Debug build tree.",
      "configurePreset": "debug",
      "targets": [
        "clean"
      ]
    },
    {
      "name": "clean-release",
      "displayName": "Clean Release",
      "description": "Clean the Release build tree.",
      "configurePreset": "release",
      "targets": [
        "clean"
      ]
    },
    {
      "name": "run-debug",
      "displayName": "Run Debug",
      "description": "Build and run the Debug executable.",
      "configurePreset": "debug",
      "targets": [
        "run"
      ]
    },
    {
      "name": "run-release",
      "displayName": "Run Release",
      "description": "Build and run the Release executable.",
      "configurePreset": "release",
      "targets": [
        "run"
      ]
    },
    {
      "name": "windows-build-debug",
      "displayName": "Build Windows Debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-build-release",
      "displayName": "Build Windows Release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-clean-debug",
      "displayName": "Clean Windows Debug",
      "configurePreset": "windows-debug",
      "targets": [
        "clean"
      ]
    },
    {
      "name": "windows-clean-release",
      "displayName": "Clean Windows Release",
      "configurePreset": "windows-release",
      "targets": [
        "clean"
      ]
    },
    {
      "name": "windows-run-debug",
      "displayName": "Run Windows Debug",
      "configurePreset": "windows-debug",
      "targets": [
        "run"
      ]
    },
    {
      "name": "windows-run-release",
      "displayName": "Run Windows Release",
      "configurePreset": "windows-release",
      "targets": [
        "run"
      ]
    }
  ]
}
